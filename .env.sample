# video-fetcher 环境变量样例
# 使用方式：复制本文件为 .env，再填入真实值。
#   cp .env.sample .env
# 注意：.env 含密钥，不要提交到 Git。

# ---------------------------------------------------------------------------
# SnapAny API Key
# 在 SnapAny 控制台获取：https://platform.snapany.com
# 形如：sk_snapany_xxx（请求头 Authorization: Bearer <key>）
# ---------------------------------------------------------------------------
SNAPANY_API_KEY=your_snapany_api_key_here

# ---------------------------------------------------------------------------
# 下载「主目录」
# 程序会在该目录下创建 {site}-{id}/ 子目录存放本次下载结果。
# 只保留与你当前操作系统匹配的一行；其余请删除或注释掉。
# 路径中的空格一般无需加引号；若工具不认 ~，改用绝对路径。
# ---------------------------------------------------------------------------

# macOS（推荐用绝对路径，避免部分库不展开 ~）
# DOWNLOAD_DIR=/Users/你的用户名/Downloads
DOWNLOAD_DIR=~/Downloads

# Linux 示例（二选一，按发行版与用户名改）：
# DOWNLOAD_DIR=/home/你的用户名/Downloads
# DOWNLOAD_DIR=~/Downloads

# Windows 示例（任选一种写法；反斜杠或正斜杠通常都可）：
# DOWNLOAD_DIR=C:\Users\你的用户名\Downloads
# DOWNLOAD_DIR=C:/Users/你的用户名/Downloads
# DOWNLOAD_DIR=%USERPROFILE%\Downloads
